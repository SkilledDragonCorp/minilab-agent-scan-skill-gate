# Optional: free Snyk account token for analysis slice (sends component content to Snyk).
# https://app.snyk.io/account
SNYK_TOKEN=

# Agent Scan environment label (upstream reads this; lab defaults to test).
AGENT_SCAN_ENVIRONMENT=test

# Optional Snyk-internal CI hostname (not used by the keyless lab slice).
AGENT_SCAN_CI_HOSTNAME=
